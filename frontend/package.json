{
  "name": "trading-game-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node ./node_modules/next/dist/bin/next dev",
    "build": "node ./node_modules/next/dist/bin/next build",
    "start": "node ./node_modules/next/dist/bin/next start",
    "test": "node --no-warnings=MODULE_TYPELESS_PACKAGE_JSON --test lib/adapters/*.test.ts",
    "test:e2e": "node ./node_modules/@playwright/test/cli.js test",
    "test:e2e:headed": "node ./node_modules/@playwright/test/cli.js test --headed",
    "lint": "eslint ."
  },
  "dependencies": {
    "lucide-react": "^0.511.0",
    "next": "^15.3.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.59.1",
    "@types/node": "^22.15.21",
    "@types/react": "^19.1.5",
    "@types/react-dom": "^19.1.5",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.39.4",
    "globals": "^16.4.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.46.2"
  }
}
